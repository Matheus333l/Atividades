CREATE TABLE vendas (
    id          INT AUTO_INCREMENT PRIMARY KEY,
    produto     VARCHAR(80) NOT NULL,
    quantidade  INT,
    valor       DECIMAL(10,2),
    data_venda  DATE,
    id_cliente  INT,
    id_vendedor INT,
    FOREIGN KEY (id_cliente)  REFERENCES cliente (id),
    FOREIGN KEY (id_vendedor) REFERENCES vendedor (id)
);


